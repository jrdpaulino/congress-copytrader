# Copy to .env and fill in. Never commit .env.
QUIVER_API_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Safety switches (defaults shown). Start here.
PAPER=true
DRY_RUN=true
# Only needed for real-money trading (PAPER=false and DRY_RUN=false):
# CONFIRM_LIVE_TRADING=I_UNDERSTAND_THE_RISKS

# Sizing and limits
MAX_ORDER_USD=250
MAX_DAILY_USD=1000
MAX_POSITION_PCT=0.05
MAX_OPEN_POSITIONS=20

# Signal filters
LOOKBACK_DAYS=7
MAX_TRADE_AGE_DAYS=45
MAX_REPORT_LAG_DAYS=45
MIN_AMOUNT_LOW_USD=15001
FOLLOW_SALES=false
# POLITICIAN_ALLOWLIST=Jane Doe,John Roe
# TICKER_BLOCKLIST=GME,AMC
